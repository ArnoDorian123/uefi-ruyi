##
#  ruyi flash device description.
#
#  Identical to sheng.fdf: the FV layout and the Include/*.inc fragments are the ones the
#  UniXNU boot manager and DarwinBoot already expect. Only the file name changed, so the
#  package prefix inside the includes (shengPkg/...) keeps resolving.
#
#  Copyright (c) 2018, Linaro Limited. All rights reserved.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[FD.SILICIUM_UEFI]
BaseAddress   = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress # The base address of the FLASH Device.
Size          = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize        # The size in bytes of the FLASH Device
ErasePolarity = 1

# This one is tricky, it must be: BlockSize * NumBlocks = Size
BlockSize     = 0x1000
NumBlocks     = $(FD_BLOCKS)

0x00000000|$(FD_SIZE)
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FvMain]
FvNameGuid         = 3A1F6C42-58D9-4B7E-9E10-2C7A4D8B5F31
BlockSize          = 0x1000
NumBlocks          = 0        # This FV gets compressed so make it just big enough
FvAlignment        = 8        # FV alignment and FV attributes setting.
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  !include Include/APRIORI.inc
  !include Include/DXE.inc
  # RAW.inc carries an unconditional FILE FREEFORM from Binaries/sheng/RawFiles, which does not
  # exist in this repository. Its only other content (panel XMLs) is gated on
  # USE_CUSTOM_DISPLAY_DRIVER = 1, so dropping the include costs only SecParti.cfg.
#  !include Include/RAW.inc

  # RAM Manager reads the RAM partition table published by the vendor stack.
!if $(SHENG_VENDOR_HW) == 1
  INF SiliciumPkg/Drivers/RamManagerDxe/RamManagerDxe.inf
!endif

  # SmBios
  INF MdeModulePkg/Universal/SmbiosDxe/SmbiosDxe.inf
  INF SiliciumPkg/Drivers/SmBiosTableDxe/SmBiosTableDxe.inf

  # UniXNU
  INF UniXNUPkg/Application/UniXNU/UniXNU.inf
  INF UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.inf

  # IORT DT
  INF QcomPkg/Drivers/IortDtDxe/IortDtDxe.inf

  # Device Tree
  # The merged ruyi DTB is passed to BootShim by `unixnu bootimg --dtb`, so it is not embedded
  # here. Enable this only if the boot flow has to carry the DTB inside the firmware volume.
  #INF EmbeddedPkg/Drivers/DtPlatformDxe/DtPlatformDxe.inf
  #FILE FREEFORM = 25462CDA-221F-47DF-AC1D-259CFAA4E326 {
  #  SECTION RAW = shengPkg/FdtBlob/lanai-qualcomm-ruyi.dtb
  #  SECTION UI = "DeviceTreeBlob"
  #}

  # Display: colour-band probe, then the minimal GOP on the same buffer.
  INF shengPkg/Drivers/RuyiPaintDxe/RuyiPaintDxe.inf
  INF shengPkg/Drivers/RuyiGopDxe/RuyiGopDxe.inf

  # Firmware log exporter: adds Tools -> Advanced Logger to the boot menu and shows the
  # Advanced Logger buffer as a sequence of QR frames. Dispatches on its own Depex, so its
  # position in the volume does not affect ordering.
!if $(RUYI_ADV_LOG) == 1
  INF UniXNUPkg/Driver/AdvancedLogDxe/AdvancedLogDxe.inf
!endif

  !include QcomPkg/Extra.fdf.inc

[FV.FVMAIN_COMPACT]
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  INF SiliciumPkg/Sec/Sec.inf

  FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }

  !include SiliciumPkg/Common.fdf.inc
