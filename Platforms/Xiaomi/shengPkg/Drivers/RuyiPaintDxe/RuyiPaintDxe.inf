## @file
#  Liveness probe for the ruyi display bring-up.
#
#  Arms a one second timer that repaints a moving block, so the question "is the firmware still
#  alive" can be answered on a screen that has no text output.
#
#  Copyright (c) 2026, UniXNU contributors. All rights reserved.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = RuyiPaintDxe
  FILE_GUID      = 1B7E5C2A-5F3D-4B9A-9C21-7D6E4F8A0B13
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = RuyiPaintEntry

[Sources]
  RuyiPaintDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  DebugLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[FixedPcd]
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferWidth
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferHeight

[Depex]
  TRUE
